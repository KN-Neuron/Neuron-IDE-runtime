# cmake/EmbedDefaultFont.cmake
#
# Run with `cmake -DINPUT=<font> -DOUTPUT=<file.cpp> -P`. Writes the font's bytes as a C++ array
# behind defaultFontBytes() (scene/DefaultFont.hpp).

file(READ "${INPUT}" font_hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," font_bytes "${font_hex}")

file(WRITE "${OUTPUT}" "// Generated by cmake/EmbedDefaultFont.cmake. Do not edit.
#include \"scene/DefaultFont.hpp\"

namespace {
const unsigned char kFontBytes[] = {${font_bytes}};
}  // namespace

std::span<const unsigned char> defaultFontBytes() { return kFontBytes; }
")
